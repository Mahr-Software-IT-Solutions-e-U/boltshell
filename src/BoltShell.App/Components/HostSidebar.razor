@implements IDisposable
@inject AccountManager Accounts
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject HostGroupStore Groups

<nav class="sidebar" style="flex-basis:@(Width)px" aria-label="@Tr("Hosts by Passbolt account")">
    <div class="sidebar-head">
        <span class="overline">@Tr("Hosts")</span>
        @if (!string.IsNullOrWhiteSpace(Filter))
        {
            <span class="muted" style="font-size:11px; margin-left:auto; margin-right:6px">@Tr("Filter: {0}", Filter)</span>
        }
        <div style="position:relative; display:flex; gap:2px">
            <button type="button" class="btn btn-icon btn-sm btn-ghost" aria-label="@Tr("Hide host list")" title="@Tr("Hide host list")"
                    @onclick="OnCollapse">
                <Icon Name="back" Size="15" />
            </button>
            <button type="button" class="btn btn-icon btn-sm btn-ghost" aria-label="@Tr("Add host")" title="@Tr("Add host")" @ref="_menuButton"
                    aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="ToggleMenuAsync">
                <Icon Name="plus" />
            </button>
            @if (_menuOpen)
            {
                <div class="menu-backdrop" @onclick="() => _menuOpen = false"></div>
                <div class="menu" role="menu" style="@_menuStyle">
                    <button type="button" role="menuitem" @onclick="() => Choose(OnProvision)">
                        <Icon Name="server" Size="15" /><span><b>@Tr("Provision SSH host")</b><br /><span class="muted">@Tr("Connect with a password, set up a key")</span></span>
                    </button>
                    <button type="button" role="menuitem" @onclick="() => Choose(OnCreateRdp)">
                        <Icon Name="monitor" Size="15" /><span><b>@Tr("Create RDP host")</b><br /><span class="muted">@Tr("Save Windows credentials in Passbolt")</span></span>
                    </button>
                </div>
            }
        </div>
    </div>

    @if (GroupView)
    {
        var filtering = !string.IsNullOrWhiteSpace(Filter);
        <section style="display:flex; flex-direction:column; gap:2px" aria-label="@Tr("My groups")">
            <div class="acc-head">
                <span class="overline">@Tr("My groups")</span>
                @if (Groups.SyncErrors.Count > 0)
                {
                    <span class="sync-warning" title="@SyncErrorText()">@Tr("Not synced")</span>
                }
            </div>
            @foreach (var group in Groups.Groups)
            {
                var members = Members(group).ToList();
                if (filtering && members.Count == 0)
                    continue;
                var node = HostGroupStore.GroupNode(group.Name);
                var collapsed = !filtering && Groups.IsCollapsed(node);
                <button type="button" class="tree-row" @key="node" aria-expanded="@(collapsed ? "false" : "true")"
                        title="@Tr("Right-click to rename or delete")"
                        @onclick="() => Groups.ToggleCollapsed(node)"
                        @oncontextmenu="e => OpenGroupMenu(group, e)" @oncontextmenu:preventDefault>
                    <span class="chevron @(collapsed ? "" : "open")"><Icon Name="chevron" Size="12" StrokeWidth="2.4" /></span>
                    <Icon Name="folder" Size="14" Color="#F2B84B" />
                    <span class="tree-name">@group.Name</span>
                    <span class="tree-count">@members.Count</span>
                </button>
                @if (!collapsed)
                {
                    @foreach (var (account, host) in members)
                    {
                        <HostRow @key="node + account.Id + host.Key" Account="account" Host="host" Indent="1" Selected="@IsSelected(account, host)"
                                 AccountLabel="@(Accounts.Accounts.Count > 1 ? account.Config.DisplayName : null)"
                                 OnOpen="() => OnOpen.InvokeAsync((account, host))"
                                 OnContextMenu="e => OpenHostMenu((account, host, e))" />
                    }
                    @if (members.Count == 0)
                    {
                        <span class="muted" style="font-size:12px; padding:2px 8px 4px 24px">@Tr("Empty – right-click a host to add it.")</span>
                    }
                }
            }
            @if (Groups.Groups.Count == 0)
            {
                <span class="muted" style="font-size:12px; padding:2px 8px">@Tr("No groups yet – right-click a host to create one.")</span>
            }
        </section>
    }

    @foreach (var account in Accounts.Accounts)
    {
        var hosts = Filtered(account).ToList();
        <section style="display:flex; flex-direction:column; gap:2px" @key="account.Id">
            <div class="acc-head">
                <span class="dot" style="background:@(account.IsUnlocked ? "#4ADE80" : "#F2B84B")"></span>
                <div style="display:flex; flex-direction:column; min-width:0">
                    <span class="acc-name">@account.Config.DisplayName</span>
                    <span class="acc-url">@Host(account)</span>
                </div>
                @if (account.IsUnlocked)
                {
                    <button type="button" class="btn btn-icon btn-sm btn-ghost" style="margin-left:auto" aria-label="@Tr("Sync {0}", account.Config.DisplayName)"
                            title="@Tr("Sync")" @onclick="() => RefreshAsync(account)" disabled="@_refreshing.Contains(account.Id)">
                        <Icon Name="refresh" Size="14" />
                    </button>
                }
                else
                {
                    <span style="margin-left:auto; font-size:11px; color:#F2C66B">@Tr("Locked")</span>
                }
            </div>

            @if (!account.IsUnlocked && account.Resources.Count == 0)
            {
                <button type="button" class="btn btn-sm" style="margin:0 6px" @onclick="() => UnlockDialog.ShowAsync(Dialogs, account)">
                    <Icon Name="locked" Size="14" />@Tr("Unlock to load hosts")
                </button>
            }
            else if (hosts.Count == 0)
            {
                <span class="muted" style="font-size:12px; padding:2px 8px">@(string.IsNullOrWhiteSpace(Filter) ? Tr("No resources with ssh:// or rdp://.") : Tr("No matches."))</span>
            }
            else if (GroupView)
            {
                // Group view: the account lists the hosts that are in no group.
                var ungrouped = hosts.Where(h => !Groups.IsGrouped(account.Id, h.Key))
                    .OrderBy(h => h.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
                var node = "ungrouped:" + account.Id;
                var collapsed = string.IsNullOrWhiteSpace(Filter) && Groups.IsCollapsed(node);
                @if (ungrouped.Count > 0)
                {
                    <button type="button" class="tree-row" aria-expanded="@(collapsed ? "false" : "true")" @onclick="() => Groups.ToggleCollapsed(node)">
                        <span class="chevron @(collapsed ? "" : "open")"><Icon Name="chevron" Size="12" StrokeWidth="2.4" /></span>
                        <span class="tree-name">@Tr("Without group")</span>
                        <span class="tree-count">@ungrouped.Count</span>
                    </button>
                    @if (!collapsed)
                    {
                        @foreach (var host in ungrouped)
                        {
                            <HostRow @key="host.Key" Account="account" Host="host" Indent="1" Selected="@IsSelected(account, host)"
                                     OnOpen="() => OnOpen.InvokeAsync((account, host))"
                                     OnContextMenu="e => OpenHostMenu((account, host, e))" />
                        }
                    }
                }
                else
                {
                    <span class="muted" style="font-size:12px; padding:2px 8px">@Tr("All hosts are in groups.")</span>
                }
            }
            else
            {
                <HostFolder Account="account" Node="@HostTree.Build(account.Folders, hosts)" Filtering="@(!string.IsNullOrWhiteSpace(Filter))"
                            IsSelected="IsSelected" OnOpen="OnOpen" OnContextMenu="OpenHostMenu" />
            }
        </section>
    }

    @if (_hostMenu is { } target)
    {
        <div class="menu-backdrop" @onclick="CloseMenus" @oncontextmenu="CloseMenus" @oncontextmenu:preventDefault></div>
        <div class="menu" role="menu" style="@_contextStyle" @ref="_contextMenu">
            <span class="menu-label">@Tr("Groups for {0}", target.Host.DisplayName)</span>
            @foreach (var group in Groups.Groups)
            {
                var member = Groups.IsMember(group.Name, target.Account.Id, target.Host.Key);
                <button type="button" role="menuitemcheckbox" aria-checked="@(member ? "true" : "false")"
                        @onclick="() => ToggleMember(group, target)">
                    <span class="menu-check">@(member ? "✓" : "")</span><span>@group.Name</span>
                </button>
            }
            <button type="button" role="menuitem" @onclick="() => NewGroupAsync(target)">
                <Icon Name="plus" Size="15" /><span>@Tr("New group …")</span>
            </button>
        </div>
    }
    @if (_groupMenu is { } selected)
    {
        <div class="menu-backdrop" @onclick="CloseMenus" @oncontextmenu="CloseMenus" @oncontextmenu:preventDefault></div>
        <div class="menu" role="menu" style="@_contextStyle" @ref="_contextMenu">
            <span class="menu-label">@selected.Name</span>
            <button type="button" role="menuitem" @onclick="() => RenameGroupAsync(selected)"><Icon Name="edit" Size="15" /><span>@Tr("Rename …")</span></button>
            <button type="button" role="menuitem" @onclick="() => DeleteGroupAsync(selected)"><Icon Name="trash" Size="15" /><span>@Tr("Delete group")</span></button>
        </div>
    }

    <div class="sidebar-hint">
        @Tr("Hosts are Passbolt resources with a URI") <span class="mono" style="color:var(--text)">ssh://user@host</span>
        @Tr("or") <span class="mono" style="color:var(--text)">rdp://user@host</span>.
    </div>
</nav>

@code {
    [Parameter] public string? Filter { get; set; }
    [Parameter] public int Width { get; set; } = AppSettings.DefaultSidebarWidth;
    [Parameter] public EventCallback OnCollapse { get; set; }
    /// <summary>The active tab; its host is highlighted.</summary>
    [Parameter] public SessionTab? SelectedTab { get; set; }
    [Parameter] public EventCallback<(AccountSession Account, HostEntry Host)> OnOpen { get; set; }
    [Parameter] public EventCallback OnProvision { get; set; }
    [Parameter] public EventCallback OnCreateRdp { get; set; }

    private bool _menuOpen;
    private ElementReference _menuButton;
    private string _menuStyle = "";

    // The sidebar scrolls (and clips), so the menu is positioned on the viewport below the button,
    // kept inside the window instead of opening past its left edge.
    private async Task ToggleMenuAsync()
    {
        if (!_menuOpen)
        {
            var rect = await JS.InvokeAsync<double[]>("pbsshMenu.anchor", _menuButton);
            var left = Math.Max(8, rect[0] - 280);
            _menuStyle = FormattableString.Invariant($"top:{rect[1] + 6:0}px; left:{left:0}px");
        }
        _menuOpen = !_menuOpen;
    }

    private Task Choose(EventCallback action)
    {
        _menuOpen = false;
        return action.InvokeAsync();
    }

    private readonly HashSet<string> _refreshing = [];

    private (AccountSession Account, HostEntry Host)? _hostMenu;
    private MergedHostGroup? _groupMenu;
    private string _contextStyle = "";
    private ElementReference _contextMenu;
    private bool _placeMenu;

    private bool GroupView => Groups.View == HostListView.Groups;

    // Members of a group that are known (account unlocked at least once) and match the filter.
    private IEnumerable<(AccountSession Account, HostEntry Host)> Members(MergedHostGroup group)
    {
        var all = Accounts.Accounts.SelectMany(a => a.Hosts.Select(h => (Account: a, Host: h)))
            .ToDictionary(x => (x.Account.Id, x.Host.Key));
        return group.Members.Where(all.ContainsKey).Select(key => all[key])
            .Where(x => Matches(x.Account, x.Host, Filter))
            .OrderBy(x => x.Host.DisplayName, StringComparer.OrdinalIgnoreCase);
    }

    private string SyncErrorText() => string.Join("\n", Groups.SyncErrors.Select(e =>
        Tr("{0}: {1}", Accounts.Find(e.Key)?.Config.DisplayName ?? e.Key, e.Value)));

    private void OpenHostMenu((AccountSession Account, HostEntry Host, MouseEventArgs Event) target)
    {
        _groupMenu = null;
        _hostMenu = (target.Account, target.Host);
        PlaceMenu(target.Event);
    }

    private void OpenGroupMenu(MergedHostGroup group, MouseEventArgs e)
    {
        _hostMenu = null;
        _groupMenu = group;
        PlaceMenu(e);
    }

    private void PlaceMenu(MouseEventArgs e)
    {
        _contextStyle = FormattableString.Invariant($"top:{e.ClientY:0}px; left:{e.ClientX:0}px");
        _placeMenu = true;
    }

    // A context menu opened near the bottom or right edge is moved back inside the window.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_placeMenu && (_hostMenu is not null || _groupMenu is not null))
        {
            _placeMenu = false;
            await JS.InvokeVoidAsync("pbsshMenu.keepInside", _contextMenu);
        }
    }

    private void CloseMenus()
    {
        _hostMenu = null;
        _groupMenu = null;
    }

    private void ToggleMember(MergedHostGroup group, (AccountSession Account, HostEntry Host) target)
    {
        CloseMenus();
        Groups.ToggleMember(group.Name, target.Account.Id, target.Host.Key);
    }

    private async Task NewGroupAsync((AccountSession Account, HostEntry Host) target)
    {
        CloseMenus();
        if (await TextPromptDialog.ShowAsync(Dialogs, Tr("New group"), Tr("Name")) is { } name && !string.IsNullOrWhiteSpace(name))
            Groups.Create(name, target.Account.Id, target.Host.Key);
    }

    private async Task RenameGroupAsync(MergedHostGroup group)
    {
        CloseMenus();
        if (await TextPromptDialog.ShowAsync(Dialogs, Tr("Rename group"), Tr("Name"), initialValue: group.Name) is { } name
            && !string.IsNullOrWhiteSpace(name))
            Groups.Rename(group.Name, name);
    }

    private async Task DeleteGroupAsync(MergedHostGroup group)
    {
        CloseMenus();
        if (await TextPromptDialog.ConfirmAsync(Dialogs, Tr("Delete group"),
                Tr("Delete the group \"{0}\"? The hosts stay in Passbolt.", group.Name), Tr("Delete")))
            Groups.Delete(group.Name);
    }

    protected override void OnInitialized()
    {
        Accounts.Changed += OnChanged;
        Groups.Changed += OnChanged;
    }

    private IEnumerable<HostEntry> Filtered(AccountSession account) =>
        account.Hosts.Where(h => Matches(account, h, Filter));

    private bool IsSelected(AccountSession account, HostEntry host) =>
        SelectedTab?.Is(account.Id, host.Resource.Id, host.Uri) == true
        && (SelectedTab.HostUri is not null || HostEntry.For(host.Resource)[0].Uri == host.Uri);

    /// <summary>Hosts across all accounts matching a search query (every word must match).</summary>
    public static IEnumerable<(AccountSession Account, HostEntry Host)> Match(AccountManager accounts, string? query) =>
        accounts.Accounts.SelectMany(a => a.Hosts.Where(h => Matches(a, h, query)).Select(h => (a, h)));

    private static bool Matches(AccountSession account, HostEntry host, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;
        var r = host.Resource;
        // A full user@host:port query should still find the matching host.
        if (!host.IsRdp && SshTarget.TryParseQuick(query, out var target)
            && string.Equals(host.Host, target.Host, StringComparison.OrdinalIgnoreCase) && host.Port == target.Port)
            return true;
        return query.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(term =>
            r.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || r.Username?.Contains(term, StringComparison.OrdinalIgnoreCase) == true
            || host.Uri.Contains(term, StringComparison.OrdinalIgnoreCase)
            || account.FolderPath(r.FolderParentId).Contains(term, StringComparison.OrdinalIgnoreCase));
    }



    private static string Host(AccountSession account) =>
        Uri.TryCreate(account.Config.Account.BaseUrl, UriKind.Absolute, out var uri) ? uri.Authority : account.Config.Account.BaseUrl;

    private async Task RefreshAsync(AccountSession account)
    {
        _refreshing.Add(account.Id);
        try
        {
            await account.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{account.Config.DisplayName}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _refreshing.Remove(account.Id);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Accounts.Changed -= OnChanged;
        Groups.Changed -= OnChanged;
    }
}
