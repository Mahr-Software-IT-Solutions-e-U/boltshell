<MudDialog>
    <DialogContent>
        <form @onsubmit="Submit" @onsubmit:preventDefault style="display:flex; flex-direction:column; gap:14px; padding-top:4px">
            <p class="muted" style="margin:0; font-size:13px; line-height:1.5">
                Direkte Verbindung ohne Passbolt-Ressource. Das Passwort wird nur für diese Sitzung im Speicher gehalten.
            </p>
            <div style="display:grid; grid-template-columns: 3fr 1fr; gap:12px">
                <label class="field">Host
                    <input class="input mono" @bind="_host" @bind:event="oninput" />
                </label>
                <label class="field">Port
                    <input class="input mono" type="number" min="1" max="65535" @bind="_port" @bind:event="oninput" />
                </label>
            </div>
            <label class="field">Benutzer
                <input class="input mono" @bind="_user" @bind:event="oninput" autofocus="@(_user is null)" />
            </label>
            <label class="field">Passwort
                <input class="input" type="password" @bind="_password" @bind:event="oninput" autofocus="@(_user is not null)" />
            </label>
            @if (_error is not null)
            {
                <span class="error-text" role="alert">@_error</span>
            }
            <div style="display:flex; justify-content:flex-end; gap:8px">
                <button type="button" class="btn" @onclick="() => MudDialog.Cancel()">Abbrechen</button>
                <button type="submit" class="btn btn-primary">Verbinden</button>
            </div>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public SshTarget Target { get; set; } = null!;

    private string _host = "";
    private int _port = 22;
    private string? _user;
    private string? _password;
    private string? _error;

    protected override void OnInitialized()
    {
        _host = Target.Host;
        _port = Target.Port;
        _user = Target.Username;
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_host) || string.IsNullOrWhiteSpace(_user) || _port is < 1 or > 65535)
        {
            _error = "Bitte Host, Port und Benutzer angeben.";
            return;
        }
        var target = new SshTarget(_host.Trim(), _port);
        MudDialog.Close(DialogResult.Ok(new SshConnectionSpec(
            target.HostAndPort, target, _user.Trim(), new SshCredentials(_password, null, null))));
    }

    public static async Task<SshConnectionSpec?> ShowAsync(IDialogService dialogs, SshTarget target)
    {
        var dialog = await dialogs.ShowAsync<QuickConnectDialog>("Schnellverbindung",
            new DialogParameters<QuickConnectDialog> { { d => d.Target, target } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: SshConnectionSpec spec } ? spec : null;
    }
}
