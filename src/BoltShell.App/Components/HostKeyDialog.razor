<MudDialog>
    <DialogContent>
        <div style="display:flex; flex-direction:column; gap:12px; font-size:13px; line-height:1.5">
            @if (Key.Status == HostKeyStatus.Changed)
            {
                <div role="alert" style="padding:12px; border-radius:8px; background:#2A1414; border:1px solid #5A2626; color:#FFB4AB">
                    @Tr("The host key of") <b>@Key.HostKeyId</b> @Tr("has changed since the last connection. Someone could be intercepting the connection (man-in-the-middle), or the server was reinstalled. Only continue if you have verified the new fingerprint.")
                </div>
                <div>
                    <div class="muted">@Tr("Previously trusted:")</div>
                    <div class="mono" style="word-break:break-all">SHA256:@Key.PreviousFingerprint</div>
                </div>
            }
            else
            {
                <p style="margin:0">@Tr("The authenticity of") <b>@Key.HostKeyId</b> @Tr("has not been confirmed yet.")</p>
            }
            <div>
                <div class="muted">@Tr("Presented key ({0}):", IsCertificate ? Tr("TLS certificate") : Key.Algorithm)</div>
                <div class="mono" style="word-break:break-all">SHA256:@Key.FingerprintSha256</div>
            </div>
            <p class="muted" style="margin:0; font-size:12px">
                @Tr("Tip: store the fingerprint in Passbolt in the field")
                <span class="mono">@(IsCertificate ? "rdp_cert_sha256" : "ssh_host_key")</span>@Tr(", and this prompt will no longer appear for the whole team.")
            </p>
            <div style="display:flex; justify-content:flex-end; gap:8px; padding-top:4px">
                <button type="button" class="btn" @onclick="() => MudDialog.Cancel()">@Tr("Cancel")</button>
                <button type="button" class="btn btn-primary" @onclick="() => MudDialog.Close(DialogResult.Ok(true))">
                    @(Key.Status == HostKeyStatus.Changed ? Tr("Replace key & connect") : Tr("Trust & connect"))
                </button>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public HostKeyInfo Key { get; set; } = null!;

    private bool IsCertificate => Key.Algorithm == BoltShell.Core.Rdp.RdpProxy.CertificateAlgorithm;
}
