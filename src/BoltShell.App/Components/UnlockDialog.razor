<MudDialog>
    <DialogContent>
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault style="display:flex; flex-direction:column; gap:14px; padding-top:4px">
            <span class="acc-url">@Account.Config.Account.BaseUrl</span>
            @if (Account.MfaPending)
            {
                <label class="field">@Tr("One-time code (TOTP)")
                    <input class="input mono" @bind="_totp" @bind:event="oninput" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus disabled="@_busy" />
                </label>
            }
            else
            {
                <label class="field">@Tr("Passphrase of the Passbolt key")
                    <input class="input" type="password" @bind="_passphrase" @bind:event="oninput" autofocus disabled="@_busy" />
                </label>
            }
            @if (_error is not null)
            {
                <span class="error-text" role="alert">@_error</span>
            }
            <div style="display:flex; justify-content:flex-end; gap:8px">
                <button type="button" class="btn" @onclick="() => MudDialog.Cancel()" disabled="@_busy">@Tr("Cancel")</button>
                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @(_busy ? Tr("Please wait…") : Account.MfaPending ? Tr("Confirm") : Tr("Unlock"))
                </button>
            </div>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public AccountSession Account { get; set; } = null!;

    private string? _passphrase;
    private string? _totp;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            _error = await UnlockAsync(Account, _passphrase, _totp);
            _passphrase = null;
            if (Account.IsUnlocked)
                MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Runs the unlock or TOTP step; returns a user-facing error message, or null.</summary>
    public static async Task<string?> UnlockAsync(AccountSession account, string? passphrase, string? totp)
    {
        try
        {
            if (account.MfaPending)
                await account.VerifyTotpAsync(totp?.Trim() ?? "");
            else
                await account.UnlockAsync(passphrase ?? "");
            return null;
        }
        catch (Org.BouncyCastle.Bcpg.OpenPgp.PgpException)
        {
            return Tr("Wrong passphrase.");
        }
        catch (HttpRequestException ex)
        {
            return Tr("Server unreachable: {0}", ex.Message);
        }
        catch (Exception ex)
        {
            return ex.Message;
        }
    }

    /// <summary>Asks for the passphrase (and TOTP if required). Returns true once the account is unlocked.</summary>
    public static async Task<bool> ShowAsync(IDialogService dialogs, AccountSession account)
    {
        if (account.IsUnlocked)
            return true;
        var dialog = await dialogs.ShowAsync<UnlockDialog>(Tr("Unlock {0}", account.Config.DisplayName),
            new DialogParameters<UnlockDialog> { { d => d.Account, account } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false } && account.IsUnlocked;
    }
}
