@inject AccountManager Accounts
@inject WorkspaceState State
@inject RdpProxy RdpProxy
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* Shows whether the server's identity is pinned in Passbolt: a warning if not (with "store in Passbolt"),
   a prominent alert if it contradicts Passbolt (with "update in Passbolt" after an explicit confirmation). *@
@if (Current() is { } identity)
{
    <div class="identity-bar @(identity.Mismatch ? "identity-alert" : "identity-warn")" role="@(identity.Mismatch ? "alert" : "status")">
        <Icon Name="shield" Size="15" />
        <div class="identity-text">
            @if (identity.Mismatch)
            {
                <b>@Tr("Server identity differs from Passbolt – connection refused.")</b>
                <span>
                    @Tr("The server presents {0}, Passbolt ({1}) expects {2}.", "SHA256:" + identity.Presented, identity.Field,
                        string.Join(", ", identity.Expected.Select(f => "SHA256:" + f)))
                    @Tr("This may be an attack (man-in-the-middle). Only update it if the server is known to have been reinstalled or received a new certificate – ideally verify the fingerprint directly on the server first.")
                </span>
            }
            else
            {
                <b>@Tr("Host identity is not stored in Passbolt.")</b>
                <span>
                    @(identity.IsRdp
                        ? Tr("The certificate {0} is only checked locally on this computer. Stored in Passbolt ({1}), everyone on the team checks it.", "SHA256:" + identity.Presented, identity.Field)
                        : Tr("The host key {0} is only checked locally on this computer. Stored in Passbolt ({1}), everyone on the team checks it.", "SHA256:" + identity.Presented, identity.Field))
                </span>
            }
        </div>
        <div class="identity-actions">
            @if (CanStore)
            {
                <button type="button" class="btn btn-sm @(identity.Mismatch ? "" : "btn-primary")" disabled="@_saving" @onclick="() => StoreAsync(identity)">
                    @(_saving ? Tr("Saving …") : identity.Mismatch ? Tr("Update in Passbolt …") : Tr("Store in Passbolt"))
                </button>
            }
            @if (!identity.Mismatch)
            {
                <button type="button" class="btn btn-sm" @onclick="Dismiss">@Tr("Dismiss")</button>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public SessionTab Tab { get; set; } = null!;

    private bool _saving;

    private sealed record Identity(bool IsRdp, string Field, string Presented, string Value, IReadOnlyList<string> Expected, bool Mismatch);

    private bool CanStore => Tab.AccountId is not null && Tab.ResourceId is not null;

    private Identity? Current()
    {
        if (Tab.Rdp is { } rdp)
        {
            // Hidden as soon as Passbolt (as currently known to this tab) holds the presented certificate.
            if (RdpProxy.Observed(rdp.Id) is not { } seen || rdp.Spec.CertificateFingerprints.Contains(seen.FingerprintSha256))
                return null;
            if (seen.Mismatch)
                return new Identity(true, RdpConnectionMapper.CertificateField, seen.FingerprintSha256, seen.FingerprintSha256, seen.Expected, true);
            if (Tab.RdpState != SessionState.Connected || rdp.Spec.CertificateFingerprints.Count > 0)
                return null; // only warn about a connection that was actually accepted
            return Visible(new Identity(true, RdpConnectionMapper.CertificateField, seen.FingerprintSha256, seen.FingerprintSha256, [], false));
        }
        if (Tab.Terminal is not { ObservedHostKey: { } line } terminal)
            return null;
        var presented = SshConnectionMapper.ParseHostKeys(line)[0].FingerprintSha256;
        if (Tab.Spec?.HostKeys?.Any(k => k.FingerprintSha256 == presented) == true)
            return null;
        if (terminal.HostKeyMismatch is { } mismatch)
            return new Identity(false, SshConnectionMapper.HostKeyField, presented, line, mismatch.ExpectedFingerprints, true);
        if (terminal.State != SessionState.Connected || Tab.Spec?.HasPinnedHostKeys == true)
            return null;
        return Visible(new Identity(false, SshConnectionMapper.HostKeyField, presented, line, [], false));
    }

    private Identity? Visible(Identity identity) => identity.Mismatch || !Tab.HostIdentityDismissed ? identity : null;

    private void Dismiss()
    {
        Tab.HostIdentityDismissed = true;
        State.Notify();
    }

    private async Task StoreAsync(Identity identity)
    {
        if (Accounts.Find(Tab.AccountId!) is not { } account)
        {
            Snackbar.Add(Tr("The Passbolt account of this session was removed."), Severity.Warning);
            return;
        }
        if (identity.Mismatch && !await TextPromptDialog.ConfirmAsync(Dialogs, Tr("Replace host identity?"),
                Tr("The entry {0} in Passbolt will be replaced by {1} – for everyone using this resource. Only confirm if you are sure the server has changed and this is not an attack.",
                    identity.Field, "SHA256:" + identity.Presented), Tr("Replace")))
            return;
        if (!await UnlockDialog.ShowAsync(Dialogs, account))
            return;
        if (account.Resources.FirstOrDefault(r => r.Id == Tab.ResourceId) is not { } resource)
        {
            Snackbar.Add(Tr("The resource no longer exists in Passbolt."), Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await account.SetCustomFieldAsync(resource, identity.Field, identity.Value);
            if (identity.IsRdp)
                State.UpdateHostIdentity(account.Id, resource.Id, null, [identity.Value], RdpProxy);
            else
                State.UpdateHostIdentity(account.Id, resource.Id, SshConnectionMapper.ParseHostKeys(identity.Value), null, RdpProxy);
            Snackbar.Add(identity.Mismatch
                ? Tr("{0} updated in Passbolt – please reconnect.", identity.Field)
                : Tr("{0} stored in Passbolt. The identity is now checked against Passbolt.", identity.Field), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Tr("Saving to Passbolt failed: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
