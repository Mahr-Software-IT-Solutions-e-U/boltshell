@implements IDisposable
@inject AccountManager Accounts
@inject SessionManager Sessions
@inject WorkspaceState State
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject RdpProxy RdpProxy
@inject IJSRuntime JS
@inject UpdateService Updates

<div class="ws">
    <header class="ws-header" data-drag>
        <div class="brand">
            <AppLogo Size="30" />
            <span class="brand-name">BoltShell</span>
        </div>
        <label class="quick">
            <Icon Name="search" />
            <input id="quick-connect" type="text" aria-label="@Tr("Search hosts or quick connect")" autocomplete="off" spellcheck="false"
                   placeholder="@Tr("Search hosts or connect to user@host:port")"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnQueryKeyDown" />
            <span class="kbd">@Tr("Ctrl K")</span>
        </label>
        <div class="header-right">
            @foreach (var account in Accounts.Accounts)
            {
                <button type="button" class="chip @(account.IsUnlocked ? "chip-ok" : "chip-locked")" @onclick="() => ToggleLockAsync(account)"
                        title="@(account.IsUnlocked ? Tr("Unlocked – click to lock") : Tr("Locked – click to unlock"))">
                    <Icon Name="@(account.IsUnlocked ? "unlocked" : "locked")" Size="13" StrokeWidth="2.2" />
                    @account.Config.DisplayName@(account.IsUnlocked ? "" : " · " + Tr("locked"))
                </button>
            }
            <button type="button" class="btn btn-icon" aria-label="@Tr("Manage Passbolt accounts")" title="@Tr("Passbolt accounts")" @onclick="OnManageAccounts">
                <Icon Name="settings" Size="17" />
            </button>
            <WindowControls />
        </div>
    </header>

    <div class="ws-body">
        <HostSidebar Filter="@_query" SelectedTab="@State.Active" OnOpen="OpenHostAsync" OnProvision="OnProvisionHost" OnCreateRdp="OnCreateRdpHost" />

        <main class="ws-main">
            <div class="tabbar" role="tablist" aria-label="@Tr("Sessions")">
                @foreach (var tab in State.Tabs)
                {
                    var active = tab == State.Active;
                    <div role="tab" aria-selected="@(active ? "true" : "false")" tabindex="0" class="tab @(active ? "active" : "")" @key="tab.Id"
                         @onclick="() => State.Activate(tab)" title="@($"{(tab.IsRdp ? "RDP" : "SSH")} · {tab.Username}@{tab.HostAndPort}")">
                        <span class="dot-sm" style="background:@StateColor(tab.State)"></span>
                        @tab.Title
                        <button type="button" class="tab-close" aria-label="@Tr("Close session {0}", tab.Title)" @onclick="() => CloseTabAsync(tab)" @onclick:stopPropagation>
                            <Icon Name="close" Size="12" StrokeWidth="2.4" />
                        </button>
                    </div>
                }
                <button type="button" class="tab-add" aria-label="@Tr("New session to the same host")" title="@Tr("New session to the same host")"
                        disabled="@(State.Active is null)" @onclick="DuplicateActive">
                    <Icon Name="plus" Size="15" />
                </button>
                @if (State.Active is { } current)
                {
                    <div class="tabbar-right">
                        @if (current.IsRdp)
                        {
                            <button type="button" class="btn btn-sm" disabled="@(current.State != SessionState.Connected)" @onclick="() => CtrlAltDelAsync(current)"
                                    title="@Tr("Send Ctrl+Alt+Del to the remote computer")">@Tr("Ctrl+Alt+Del")</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm toggle-sftp" aria-pressed="@(current.SftpVisible ? "true" : "false")" @onclick="() => ToggleSftp(current)">
                                <Icon Name="folder" Size="14" />@Tr("SFTP files")
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="ws-content">
                @foreach (var tab in State.Tabs)
                {
                    <div class="session" hidden="@(tab != State.Active)" @key="tab.Id">
                        <div class="term-wrap">
                            <HostIdentityBar Tab="tab" />
                            <div class="term-body">
                                @if (tab.IsRdp)
                                {
                                    <RdpTab Tab="tab" Active="@(tab == State.Active)" BeforeConnect="() => EnsureCredentialsAsync(tab)" />
                                }
                                else
                                {
                                    <TerminalTab Session="tab.Terminal!" Active="@(tab == State.Active)" Banner="@Banner(tab)" BeforeConnect="() => EnsureCredentialsAsync(tab)"
                                                 OnTitleChanged="title => OnTerminalTitle(tab, title)" OnSizeChanged="State.Notify" />
                                }
                            </div>
                        </div>
                        @if (tab.Sftp is not null)
                        {
                            <div style="display:@(tab.SftpVisible ? "flex" : "none"); flex: 1 1 380px; min-width: 320px; max-width: 520px">
                                <SftpPanel Tab="tab" BeforeConnect="() => EnsureCredentialsAsync(tab)" />
                            </div>
                        }
                    </div>
                }
                @if (State.Tabs.Count == 0)
                {
                    <div class="empty">
                        <Icon Name="terminal" Size="32" />
                        <h2>@Tr("No open session")</h2>
                        <p style="margin:0; max-width:420px; line-height:1.5">
                            @Tr("Pick a host on the left, or press Ctrl K and enter user@host:port.")
                        </p>
                    </div>
                }
            </div>
        </main>
    </div>

    <footer class="statusbar">
        @if (State.Active is { } activeTab)
        {
            <span style="display:inline-flex; align-items:center; gap:6px">
                <span class="dot-sm" style="background:@StateColor(activeTab.State)"></span>@StateText(activeTab.State) · @activeTab.HostAndPort
            </span>
            <span>Auth: @activeTab.AuthLabel</span>
            @if (activeTab.Spec?.HasPinnedHostKeys == true || activeTab.Rdp?.Spec.CertificateFingerprints.Count > 0)
            {
                <span style="display:inline-flex; align-items:center; gap:5px" title="@Tr("The server identity is checked against Passbolt")">
                    <Icon Name="shield" Size="13" />@Tr("Host identity from Passbolt")
                </span>
            }
        }
        @if (Updates.AvailableVersion is { } newVersion)
        {
            <button type="button" class="linklike" style="font-size:12px" disabled="@Updates.IsDownloading" @onclick="InstallUpdateAsync"
                    title="@Tr("Downloads the new version and restarts BoltShell")">
                @(Updates.IsDownloading ? Tr("Downloading update … {0} %", Updates.Progress) : Tr("Update to {0} available – install now", newVersion))
            </button>
        }
        <span>Passbolt: @(Accounts.Accounts.Count == 1 ? Tr("1 account") : Tr("{0} accounts", Accounts.Accounts.Count)) · @Tr("{0} locked", Accounts.LockedCount)</span>
        @if (State.Active is { Terminal: { } term })
        {
            <span class="mono" style="margin-left:auto">xterm-256color · UTF-8 · @(term.Size.Columns)×@(term.Size.Rows)</span>
        }
        else if (State.Active is { RdpDesktopSize: { } desktop })
        {
            <span class="mono" style="margin-left:auto">RDP · @(desktop.Width)×@(desktop.Height)</span>
        }
    </footer>
</div>

@code {
    [Parameter] public EventCallback OnManageAccounts { get; set; }
    [Parameter] public EventCallback OnProvisionHost { get; set; }
    [Parameter] public EventCallback OnCreateRdpHost { get; set; }

    private string? _query;

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Accounts.Changed += OnAccountsChanged;
        Updates.Changed += OnChanged;
        Updates.Start();
    }

    private Task InstallUpdateAsync() => UpdateCard.InstallAsync(Updates, State, Dialogs, Snackbar);

    private async Task OpenHostAsync((AccountSession Account, HostEntry Host) selection)
    {
        var (account, host) = selection;
        var resource = host.Resource;
        if (!await UnlockDialog.ShowAsync(Dialogs, account))
            return;
        if (host.IsRdp)
        {
            try
            {
                State.OpenRdp(RdpProxy, await account.GetRdpSpecAsync(resource, host.Uri), account.Id, resource.Id, host.Uri);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{resource.Name}: {ex.Message}", Severity.Error);
            }
            return;
        }
        SshConnectionSpec spec;
        try
        {
            spec = await account.GetConnectionSpecAsync(resource, host.Uri);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{resource.Name}: {ex.Message}", Severity.Error);
            return;
        }
        AddTab(spec, account.Id, resource.Id, host.Uri);
    }

    private void AddTab(SshConnectionSpec spec, string? accountId, string? resourceId, string? hostUri = null) =>
        State.Open(Sessions, spec, accountId, resourceId, hostUri);

    private async Task DuplicateActive()
    {
        if (State.Active is not { } tab || !await EnsureCredentialsAsync(tab))
            return;
        if (tab.IsRdp)
            State.OpenRdp(RdpProxy, tab.Rdp!.Spec, tab.AccountId, tab.ResourceId, tab.HostUri);
        else if (tab.Spec is { } spec)
            AddTab(spec, tab.AccountId, tab.ResourceId, tab.HostUri);
    }

    /// <summary>
    /// Gate for every new connection from an existing tab (duplicate, reconnect, SFTP): if the tab's Passbolt account was
    /// locked meanwhile, its cached credentials are gone – ask for the passphrase and decrypt them freshly from Passbolt.
    /// </summary>
    private async Task<bool> EnsureCredentialsAsync(SessionTab tab)
    {
        if (!tab.CredentialsCleared || tab.AccountId is null)
            return true;
        if (Accounts.Find(tab.AccountId) is not { } account)
        {
            Snackbar.Add(Tr("The Passbolt account of this session was removed."), Severity.Warning);
            return false;
        }
        if (!await UnlockDialog.ShowAsync(Dialogs, account))
            return false;
        if (account.Resources.FirstOrDefault(r => r.Id == tab.ResourceId) is not { } resource)
        {
            Snackbar.Add(Tr("The resource no longer exists in Passbolt."), Severity.Warning);
            return false;
        }
        try
        {
            if (tab.IsRdp)
                State.RestoreCredentials(tab, null, await account.GetRdpSpecAsync(resource, tab.HostUri), RdpProxy);
            else
                State.RestoreCredentials(tab, await account.GetConnectionSpecAsync(resource, tab.HostUri), null, RdpProxy);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{resource.Name}: {ex.Message}", Severity.Error);
            return false;
        }
    }

    // Locking an account (manually or by auto-lock) drops the credentials cached in its tabs.
    private void OnAccountsChanged()
    {
        foreach (var account in Accounts.Accounts.Where(a => !a.IsUnlocked))
            State.ClearCredentials(account.Id, RdpProxy);
        OnChanged();
    }

    private async Task CtrlAltDelAsync(SessionTab tab)
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/rdp.js");
        await module.InvokeVoidAsync("ctrlAltDel", tab.Rdp!.Id);
    }

    private async Task CloseTabAsync(SessionTab tab)
    {
        if (tab.Sftp?.Transfers.Any(t => t.State == TransferState.Running) == true
            && !await TextPromptDialog.ConfirmAsync(Dialogs, Tr("Transfers running"), Tr("Close the session and cancel running transfers?"), Tr("Close")))
            return;
        State.Remove(tab);
        if (tab.Terminal is not null)
            await Sessions.CloseAsync(tab.Terminal.Id);
        if (tab.Sftp is not null)
            await Sessions.CloseAsync(tab.Sftp.Id);
    }

    private async Task ToggleSftp(SessionTab tab)
    {
        if (tab.Spec is null)
            return;
        if (tab.Sftp is null && !await EnsureCredentialsAsync(tab))
            return;
        tab.Sftp ??= Sessions.CreateSftp(tab.Spec);
        tab.SftpVisible = !tab.SftpVisible;
        State.Notify();
    }

    private void OnTerminalTitle(SessionTab tab, string title)
    {
        if (tab.UpdateFromTitle(title))
            State.Notify();
    }

    private async Task ToggleLockAsync(AccountSession account)
    {
        if (account.IsUnlocked)
            account.Lock();
        else
            await UnlockDialog.ShowAsync(Dialogs, account);
    }

    private async Task OnQueryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _query = null;
            return;
        }
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_query))
            return;

        var matches = HostSidebar.Match(Accounts, _query).ToList();
        if (matches.Count == 1)
        {
            _query = null;
            await OpenHostAsync(matches[0]);
            return;
        }
        if (matches.Count == 0 && SshTarget.TryParseQuick(_query, out var target))
        {
            if (await QuickConnectDialog.ShowAsync(Dialogs, target) is { } spec)
            {
                _query = null;
                AddTab(spec, null, null);
            }
            return;
        }
        if (matches.Count > 1)
            Snackbar.Add(Tr("{0} hosts match – narrow the search or pick one on the left.", matches.Count), Severity.Info);
        else
            Snackbar.Add(Tr("No host found. Enter user@host:port for a direct connection."), Severity.Info);
    }

    private static string Banner(SessionTab tab) =>
        tab.AccountId is null
            ? Tr("Direct connection · password only in memory")
            : tab.Spec!.Credentials.HasPrivateKey
                ? Tr("Key from Passbolt · {0} · decrypted in memory only", tab.Spec.DisplayName)
                : Tr("Password from Passbolt · {0} · decrypted in memory only", tab.Spec.DisplayName);

    private static string StateColor(SessionState state) => state switch
    {
        SessionState.Connected => "#4ADE80",
        SessionState.Connecting or SessionState.Created => "#F2B84B",
        _ => "#FF8A80",
    };

    private static string StateText(SessionState state) => state switch
    {
        SessionState.Connected => Tr("Connected"),
        SessionState.Connecting or SessionState.Created => Tr("Connecting"),
        SessionState.Closed => Tr("Disconnected"),
        _ => Tr("Error"),
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Accounts.Changed -= OnAccountsChanged;
        Updates.Changed -= OnChanged;
    }
}
